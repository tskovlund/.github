{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Shared Renovate policy for all tskovlund repositories — extend with \"github>tskovlund/.github\"",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests"],
  "timezone": "Europe/Copenhagen",
  "schedule": ["before 7am on monday"],
  "labels": ["dependencies"],
  "prConcurrentLimit": 10,
  "semanticCommits": "enabled",
  "configMigration": true,
  "nix": {
    "enabled": true
  },
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true
  },
  "packageRules": [
    {
      "description": "Auto-merge non-major updates once checks pass; majors wait for a human",
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "automerge": true
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions",
      "semanticCommitType": "ci"
    },
    {
      "description": "Interpreter bumps in .python-version must be paired with pyproject, flake and CI changes, so never auto-merge them",
      "matchManagers": ["pyenv"],
      "automerge": false
    }
  ],
  "vulnerabilityAlerts": {
    "labels": ["security"]
  }
}
